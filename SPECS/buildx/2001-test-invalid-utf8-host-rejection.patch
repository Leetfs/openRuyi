From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Tue, 20 Oct 2026 10:29:00 +0800
Subject: [PATCH] Expect an error for an invalid UTF-8 hostname

The bundled IDNA lookup profile rejects the invalid UTF-8 byte in
\x94.EXAMPLE.COM. Move this input out of the successful normalization
cases and check the error returned by normalizeHTTPHost.

Upstream: https://github.com/docker/buildx/blob/v0.38.0/policy/validate_test.go
Upstream-Status: Pending
Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
--- a/policy/validate_test.go
+++ b/policy/validate_test.go
@@ -35,7 +35,6 @@
 		{"http", "Example.com", "example.com"},
 		{"https", "\u0130.EXAMPLE.COM:443", "xn--i-9bb.example.com"},
 		{"https", "\u00c9XAMPLE.COM", "xn--xample-9ua.com"},
-		{"https", "\x94.EXAMPLE.COM", "xn--zn7c.example.com"},
 		{"https", "EXAMPLE.COM:000443", "example.com"},
 		{"https", "eXaMpLe.CoM:8443", "example.com:8443"},
 		{"https", "example.com:443", "example.com"},
@@ -79,6 +78,11 @@
 			require.Equal(t, tt.want, host)
 		})
 	}
+}
+
+func TestNormalizeHTTPHostInvalidUTF8(t *testing.T) {
+	_, err := normalizeHTTPHost(&url.URL{Scheme: "https", Host: "\x94.EXAMPLE.COM"})
+	require.ErrorContains(t, err, "invalid http host")
 }
 
 func TestSourceToInputSingleSource(t *testing.T) {
