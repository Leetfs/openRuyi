From 0fd0f4a7ad2f2e5533e57e42c646d3618c25c2ad Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 04:11:34 +0800
Subject: [PATCH] Read the configured OpenSSL backend before initializing curl

LanguageTool includes the curl initializer without a preceding crypto configuration header. Include it before testing SYSTEM_OPENSSL so the system TLS backend keeps its configured trust store.
---
 include/systools/curlinit.hxx | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/include/systools/curlinit.hxx b/include/systools/curlinit.hxx
index 26e46d2..ad1bd03 100644
--- a/include/systools/curlinit.hxx
+++ b/include/systools/curlinit.hxx
@@ -9,6 +9,8 @@
 
 #pragma once
 
+#include <config_crypto.h>
+
 #include <curl/curl.h>
 
 #include <officecfg/Office/Security.hxx>
