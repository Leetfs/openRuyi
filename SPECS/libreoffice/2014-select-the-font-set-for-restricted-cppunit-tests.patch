From ef3afee90254fba144c7dfa952e7dd8e1d16bdc8 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 15:18:14 +0800
Subject: [PATCH] Allow font-sensitive CppUnit tests to select a Fontconfig
 profile

Downstream builds may install their declared test fonts from distribution RPMs. Make the restricted test targets use that explicit font set, as they do with bundled fonts. Other test targets retain the normal system configuration. This keeps system static faces from shadowing the variable fonts embedded in the two PDF test documents.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 solenv/gbuild/CppunitTest.mk | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/solenv/gbuild/CppunitTest.mk b/solenv/gbuild/CppunitTest.mk
index 594e618..30f3d17 100644
--- a/solenv/gbuild/CppunitTest.mk
+++ b/solenv/gbuild/CppunitTest.mk
@@ -417,6 +417,11 @@ endef
 # non-bundled font (a good practice). Default is to neither deny nor abort.
 define gb_CppunitTest_set_non_application_font_use
 $(call gb_CppunitTest_get_target,$(1)) : NON_APPLICATION_FONT_USE += $(2)
+ifneq ($(strip $(LIBO_TEST_FONTCONFIG_FILE)),)
+ifneq ($(filter abort deny,$(2)),)
+$(call gb_CppunitTest_get_target,$(1)) : EXTRA_ENV_VARS += FONTCONFIG_FILE="$(LIBO_TEST_FONTCONFIG_FILE)"
+endif
+endif
 
 endef
 
