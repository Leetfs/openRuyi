From 97706aab90cc9d816f509d6cdb823efee64cd328 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 04:36:08 +0800
Subject: [PATCH] Isolate the locale and cell-reference options used by the
 tests

The VBA test selects the UK locale and Basic coverage later expects US date formatting. Restore the locale after localized fixtures. Set the range insertion test to its intended non-expanding mode even when its neighbor exercises edge expansion first.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 basic/qa/cppunit/basic_coverage.cxx | 7 ++++++-
 basic/qa/cppunit/test_vba.cxx       | 4 ++++
 sc/qa/unit/ucalc_formula.cxx        | 2 ++
 3 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/basic/qa/cppunit/basic_coverage.cxx b/basic/qa/cppunit/basic_coverage.cxx
index d839726..39d33c1 100644
--- a/basic/qa/cppunit/basic_coverage.cxx
+++ b/basic/qa/cppunit/basic_coverage.cxx
@@ -8,6 +8,7 @@
  */
 
 #include "basictest.hxx"
+#include <comphelper/scopeguard.hxx>
 #include <osl/file.hxx>
 #include <i18nlangtag/languagetag.hxx>
 #include <test/bootstrapfixture.hxx>
@@ -102,6 +103,11 @@ void Coverage::Coverage_Iterator()
     process_directory(sDirName); // any files in the root test dir are run in test harness default locale ( en-US )
     std::vector< OUString > sLangDirs = get_subdirnames( sDirName );
 
+    SvtSysLocaleOptions aLocalOptions;
+    const OUString previousLocale = aLocalOptions.GetLanguageTag().getBcp47(false);
+    comphelper::ScopeGuard restoreLocale(
+        [&] { aLocalOptions.SetLocaleConfigString(previousLocale); });
+
     for (auto const& langDir : sLangDirs)
     {
         sal_Int32 nSlash = langDir.lastIndexOf('/');
@@ -111,7 +117,6 @@ void Coverage::Coverage_Iterator()
             LanguageTag aLocale( sLangISO );
             if ( aLocale.isValidBcp47() )
             {
-                SvtSysLocaleOptions aLocalOptions;
                 // set locale for test dir
                 aLocalOptions.SetLocaleConfigString( sLangISO );
                 process_directory(langDir);
diff --git a/basic/qa/cppunit/test_vba.cxx b/basic/qa/cppunit/test_vba.cxx
index a114099..6ffc3f9 100644
--- a/basic/qa/cppunit/test_vba.cxx
+++ b/basic/qa/cppunit/test_vba.cxx
@@ -7,6 +7,7 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/.
  */
 #include "basictest.hxx"
+#include <comphelper/scopeguard.hxx>
 #include <i18nlangtag/languagetag.hxx>
 #include <unotools/syslocaleoptions.hxx>
 #include <test/bootstrapfixture.hxx>
@@ -163,6 +164,9 @@ void VBATest::testMiscVBAFunctions()
     // Some test data expects the uk locale
     LanguageTag aLocale(LANGUAGE_ENGLISH_UK);
     SvtSysLocaleOptions aLocalOptions;
+    const OUString previousLocale = aLocalOptions.GetLanguageTag().getBcp47(false);
+    comphelper::ScopeGuard restoreLocale(
+        [&] { aLocalOptions.SetLocaleConfigString(previousLocale); });
     aLocalOptions.SetLocaleConfigString( aLocale.getBcp47() );
 
     for ( size_t  i=0; i<std::size( macroSource ); ++i )
diff --git a/sc/qa/unit/ucalc_formula.cxx b/sc/qa/unit/ucalc_formula.cxx
index 3713016..407431d 100644
--- a/sc/qa/unit/ucalc_formula.cxx
+++ b/sc/qa/unit/ucalc_formula.cxx
@@ -1505,6 +1505,8 @@ CPPUNIT_TEST_FIXTURE(TestFormula, testFormulaAnnotateTrimOnDoubleRefs)
 
 CPPUNIT_TEST_FIXTURE(TestFormula, testFormulaRefUpdate)
 {
+    setExpandRefs(false);
+
     m_pDoc->InsertTab(0, u"Formula"_ustr);
 
     sc::AutoCalcSwitch aACSwitch(*m_pDoc, true); // turn auto calc on.
-- 
