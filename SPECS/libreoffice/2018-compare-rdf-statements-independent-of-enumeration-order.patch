From 3e7a68a0e4f7f624e138960b7ddbe1a94ed08c00 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 21:33:15 +0800
Subject: [PATCH] Compare RDF manifest statements independently of enumeration
 order

RDF graphs are sets of triples. The document metadata test already sorts statements after a save and reload. Apply the same ordering to both expected and actual statements when reading them directly, preserving the expected count, subjects, predicates, objects and named graphs.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 unoxml/qa/unit/rdftest.cxx | 93 ++++++++++++--------------------------
 1 file changed, 28 insertions(+), 65 deletions(-)

diff --git a/unoxml/qa/unit/rdftest.cxx b/unoxml/qa/unit/rdftest.cxx
index a55942e..a2449c1 100644
--- a/unoxml/qa/unit/rdftest.cxx
+++ b/unoxml/qa/unit/rdftest.cxx
@@ -960,6 +960,19 @@ CPPUNIT_TEST_FIXTURE(RDFStreamTest, testTdf123293)
     CPPUNIT_ASSERT(xDocRepo);
 }
 
+static void assertUnorderedStatements(const uno::Reference<container::XEnumeration>& enumeration,
+                                      const std::vector<rdf::Statement>& expected)
+{
+    std::vector<rdf::Statement> actual;
+    while (enumeration->hasMoreElements())
+        actual.push_back(enumeration->nextElement().get<rdf::Statement>());
+    CPPUNIT_ASSERT_EQUAL(expected.size(), actual.size());
+    actual = sortStatements(actual);
+    const auto sorted = sortStatements(expected);
+    for (size_t i = 0; i < actual.size(); ++i)
+        CPPUNIT_ASSERT_STATEMENT_EQUAL(sorted[i], actual[i]);
+}
