From 96e49794112c5c7f17beadd1c0c555cf3f7afa01 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 13:42:19 +0800
Subject: [PATCH] Keep the Writer/Web template out of Writer HTML imports

The HTML reader caches its first template lookup. Loading a Web document before the same HTML in Writer replaces the Writer heading styles with Web styles. Opening Writer first also prevents a later Web import from loading its own template. Only apply the HTML template for HTML-mode documents. Exercise a Web import followed by the Writer filter in the same process.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 sw/qa/extras/htmlimport/htmlimport.cxx |  7 +++++--
 sw/source/filter/basflt/shellio.cxx    | 11 +++++++----
 2 files changed, 12 insertions(+), 6 deletions(-)

diff --git a/sw/qa/extras/htmlimport/htmlimport.cxx b/sw/qa/extras/htmlimport/htmlimport.cxx
index 9fa79e7..257e5ee 100644
--- a/sw/qa/extras/htmlimport/htmlimport.cxx
+++ b/sw/qa/extras/htmlimport/htmlimport.cxx
@@ -307,9 +307,12 @@ CPPUNIT_TEST_FIXTURE(HtmlImportTest, testTableBorder1px)
 
 CPPUNIT_TEST_FIXTURE(HtmlImportTest, testOutlineLevel)
 {
+    // Populate the shared HTML reader's Writer/Web template first.
     createSwWebDoc("outline-level.html");
-    // This was 0, HTML imported into Writer lost the outline numbering for
-    // Heading 1 styles.
+    dispose();
+    createSwDoc("outline-level.html",
+                { comphelper::makePropertyValue(u"FilterName"_ustr, u"HTML (StarWriter)"_ustr) });
+    // Writer must keep its own heading outline levels after a Writer/Web import.
     CPPUNIT_ASSERT_EQUAL(static_cast<sal_Int32>(1),
                          getProperty<sal_Int32>(getParagraph(1), u"OutlineLevel"_ustr));
 }
diff --git a/sw/source/filter/basflt/shellio.cxx b/sw/source/filter/basflt/shellio.cxx
index 13c5aab..cdbf16b 100644
--- a/sw/source/filter/basflt/shellio.cxx
+++ b/sw/source/filter/basflt/shellio.cxx
@@ -133,10 +133,13 @@ ErrCodeMsg SwReader::Read( const Reader& rOptions )
     {
         // if the Reader was not called by a Shell, create a PaM ourselves
         pPam = new SwPaM( mxDoc->GetNodes().GetEndOfContent(), SwNodeOffset(-1) );
-        // For Web documents the default template was set already by InitNew,
-        // unless the filter is not HTML,
-        // or a SetTemplateName was called in ConvertFrom.
-        if( !mxDoc->getIDocumentSettingAccess().get(DocumentSettingId::HTML_MODE) || ReadHTML != po || !po->mxTemplate.is()  )
+        // Writer/Web normally applies its HTML template in InitNew. A Writer
+        // import only needs a template if the selected filter supplied one.
+        const bool bHasFilterTemplate = mpMedium && mpMedium->GetFilter()
+                                        && !mpMedium->GetFilter()->GetDefaultTemplate().isEmpty();
+        if (po != ReadHTML || bHasFilterTemplate
+            || (mxDoc->getIDocumentSettingAccess().get(DocumentSettingId::HTML_MODE)
+                && !po->mxTemplate.is()))
             po->SetTemplate( *mxDoc );
     }
 
