From 37831dfaebef8781398df69c4c4d4040f2772cd8 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 22:27:42 +0800
Subject: [PATCH] Check Writer text portions and single-page whitespace
 independently of view layout

Hiding whitespace is supported in single-page view. Select it before comparing the height of the final page with the preceding page. Centered or justified paragraphs may have empty alignment margins. Check every original portion type and space in all three paragraphs without counting these margins as content.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 sw/qa/extras/uiwriter/uiwriter4.cxx | 159 +++++++---------------------
 1 file changed, 37 insertions(+), 122 deletions(-)

diff --git a/sw/qa/extras/uiwriter/uiwriter4.cxx b/sw/qa/extras/uiwriter/uiwriter4.cxx
index 6057cff..babde16 100644
--- a/sw/qa/extras/uiwriter/uiwriter4.cxx
+++ b/sw/qa/extras/uiwriter/uiwriter4.cxx
@@ -8,6 +8,10 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/.
  */
 
+#include <initializer_list>
+#include <string_view>
+#include <utility>
+
 #include <com/sun/star/drawing/FillStyle.hpp>
 #include <com/sun/star/style/CaseMap.hpp>
 #include <swmodeltestbase.hxx>
@@ -70,6 +74,26 @@ public:
     }
 
     void mergeDocs(const char* aDestDoc, const char* aInsertDoc);
+
+    void assertTrailingBlankPortions(
+        const xmlDocUniquePtr& pXmlDoc,
+        std::initializer_list<std::pair<std::u16string_view, std::u16string_view>> aExpected)
+    {
+        assertXPath(pXmlDoc, "/root/page/body/txt", 3);
+        for (int nParagraph = 1; nParagraph <= 3; ++nParagraph)
+        {
+            // Alignment may insert empty margins at the ends of the line.
+            OString aPath = "/root/page/body/txt["_ostr + OString::number(nParagraph)
+                            + "]/SwParaPortion/SwLineLayout/*[not(@type='PortionType::Margin' and @portion='')]"_ostr;
+            assertXPath(pXmlDoc, aPath, static_cast<int>(aExpected.size()));
+            int nPortion = 0;
+            for (const auto& [type, text] : aExpected)
+            {
+                OString aPosition = aPath + "["_ostr + OString::number(++nPortion) + "]"_ostr;
+                assertXPathAttrs(pXmlDoc, aPosition, { { "type", type }, { "portion", text } });
+            }
+        }
+    }
 };
 
 void SwUiWriterTest4::mergeDocs(const char* aDestDoc, const char* aInsertDoc)
@@ -991,6 +1015,8 @@ CPPUNIT_TEST_FIXTURE(SwUiWriterTest4, testTdf96961)
 
     // Enable hide whitespace mode.
     SwViewOption aViewOptions(*pWrtShell->GetViewOptions());
+    aViewOptions.SetViewLayoutBookMode(false);
+    aViewOptions.SetViewLayoutColumns(1);
     aViewOptions.SetHideWhitespaceMode(true);
     pWrtShell->ApplyViewOptions(aViewOptions);
 
@@ -2125,61 +2151,11 @@ CPPUNIT_TEST_FIXTURE(SwUiWriterTest4, testMsWordCompTrailingBlanks_True)
