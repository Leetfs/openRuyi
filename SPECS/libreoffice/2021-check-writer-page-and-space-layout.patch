-    assertXPath(pXmlDoc, "/root/page/body/txt[3]/SwParaPortion/SwLineLayout/child::*[4]", "portion",
-                u"         "); // All the trailing blanks
+    assertTrailingBlankPortions(pXmlDoc,
+        { { u"PortionType::Text", u"TEST " },
+          { u"PortionType::Text", u"   " },
+          { u"PortionType::Text", u"   T" },
+          { u"PortionType::Hole", u"         " } });
 }
 
