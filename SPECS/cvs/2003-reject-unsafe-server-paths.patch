diff --git a/src/client.c b/src/client.c
--- a/src/client.c
+++ b/src/client.c
@@ -752,0 +753,12 @@ call_in_directory (const char *pathname,
+    /* A server may only update relative paths inside the client work tree.
+       Reject absolute paths and attempts to ascend outside the work tree so
+       that a malicious server cannot create or replace arbitrary files.  */
+    if (ISABSOLUTE (pathname) || pathname_levels (pathname) > 0)
+    {
+        error (
+            0,
+            0,
+            "Server attempted to update a file via an invalid pathname:");
+        error (1, 0, "`%s'.", pathname);
+    }
+
