From 8c210cdb3971ecfff8297efcb03a1db36a26e7ea Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 05:41:21 +0800
Subject: [PATCH] Stop at EOF after the final CJK bigram
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The last character of a bigram is reused for lookahead. Do not emit an empty token when that overlap reaches end of input. Adapt the end-of-stream check in Michael McCandless’s Apache Lucene fix for LUCENE-973.

https://github.com/apache/lucene/commit/835c405be09d20f0b174e7ce96bd675e9400c946
---
 src/contribs-lib/CLucene/analysis/cjk/CJKAnalyzer.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/src/contribs-lib/CLucene/analysis/cjk/CJKAnalyzer.cpp b/src/contribs-lib/CLucene/analysis/cjk/CJKAnalyzer.cpp
index 05a17e5..77e29b2 100644
--- a/src/contribs-lib/CLucene/analysis/cjk/CJKAnalyzer.cpp
+++ b/src/contribs-lib/CLucene/analysis/cjk/CJKAnalyzer.cpp
@@ -182,6 +182,9 @@ CL_NS(analysis)::Token* CJKTokenizer::next(Token* token){
         }
     }
 
+	if (length == 0 && dataLen == -1)
+		return NULL;
+
 	buffer[length]='\0';
 	token->set(buffer,start, start+length, tokenType);
 	return token;
