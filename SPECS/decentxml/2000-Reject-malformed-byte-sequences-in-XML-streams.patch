From beda34309fb59ccce69ac547f2cd91984e69c9e4 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 03:53:01 +0800
Subject: [PATCH] Reject malformed byte sequences when reading XML streams

InputStreamReader's charset-name constructor substitutes U+FFFD for
malformed input. That makes UTF-8 encodings of surrogate code points
indistinguishable from a valid replacement character before the parser
can validate the document. Use a reporting decoder for the declared
charset. Keep the existing diagnostic for unsupported charset names.

Check both the byte-stream error and the original parser diagnostics for
unpaired UTF-16 surrogates in W3C xmltest cases not-wf-sa-168 and -169.

Upstream: pending
Reference: https://www.w3.org/TR/xml/#charencoding
Reference: https://www.w3.org/XML/Test/xmlconf-20031210.html
Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
 .../pdark/decentxml/XMLInputStreamReader.java |  5 ++--
 .../pdark/decentxml/XMLConformanceTest.java   | 28 +++++++++++++++++--
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/src/main/java/de/pdark/decentxml/XMLInputStreamReader.java b/src/main/java/de/pdark/decentxml/XMLInputStreamReader.java
index 47c83fe..5d43adc 100644
--- a/src/main/java/de/pdark/decentxml/XMLInputStreamReader.java
+++ b/src/main/java/de/pdark/decentxml/XMLInputStreamReader.java
@@ -37,6 +37,7 @@ import java.io.InputStream;
 import java.io.InputStreamReader;
 import java.io.Reader;
 import java.io.UnsupportedEncodingException;
+import java.nio.charset.Charset;
 import java.util.HashMap;
 import java.util.Map;
 import java.util.regex.Matcher;
@@ -239,9 +240,9 @@ public class XMLInputStreamReader extends Reader
         setXmlEncoding (encoding);
         try
         {
-            delegate = new InputStreamReader (jin, javaEncoding);
+            delegate = new InputStreamReader (jin, Charset.forName (javaEncoding).newDecoder ());
         }
-        catch (UnsupportedEncodingException e)
+        catch (IllegalArgumentException e)
         {
             throw new XMLParseException ("Error parsing XML declaration: Unsupported encoding '"+javaEncoding+"'", e)
             .setSource (new XMLStringSource (s), encodingOffset);
diff --git a/src/test/java/de/pdark/decentxml/XMLConformanceTest.java b/src/test/java/de/pdark/decentxml/XMLConformanceTest.java
index 8631f08..6b61d9b 100644
--- a/src/test/java/de/pdark/decentxml/XMLConformanceTest.java
+++ b/src/test/java/de/pdark/decentxml/XMLConformanceTest.java
@@ -33,6 +33,7 @@ package de.pdark.decentxml;
 
 import java.io.File;
 import java.io.IOException;
+import java.nio.charset.MalformedInputException;
 
 import static org.junit.Assert.*;
 
@@ -389,8 +390,8 @@ public class XMLConformanceTest
     @Test public void not_wf_sa_165 () throws Exception { runInvalid ("not-wf/sa/165.xml", "Line 2, column 9: Expected whitespace after '<!ENTITY' but found \"% e \\\"\\\">\\r\\n<!ELEMENT d...\" (Token (DOCTYPE_PARAMETER_ENTITY, 25:26, \"%\"))"); }
     @Test public void not_wf_sa_166 () throws Exception { runInvalid ("not-wf/sa/166.xml", "Line 1, column 6: Illegal character found in text. Allowed values are #x09 | #x0a | #x0d | [#x0020-#xD7FF] | [#xE000-#xFFFD] | [#x10000-#x10FFFF]: [#xffff]"); }
     @Test public void not_wf_sa_167 () throws Exception { runInvalid ("not-wf/sa/167.xml", "Line 1, column 6: Illegal character found in text. Allowed values are #x09 | #x0a | #x0d | [#x0020-#xD7FF] | [#xE000-#xFFFD] | [#x10000-#x10FFFF]: [#xfffe]"); }
-    @Test public void not_wf_sa_168 () throws Exception { runInvalid ("not-wf/sa/168.xml", "Line 1, column 6: Illegal character found in text. Character after first in surrogate pair is not between 0xDC00 and 0xDFFF: 3c"); }
-    @Test public void not_wf_sa_169 () throws Exception { runInvalid ("not-wf/sa/169.xml", "Line 1, column 6: Illegal character found in text. Allowed values are #x09 | #x0a | #x0d | [#x0020-#xD7FF] | [#xE000-#xFFFD] | [#x10000-#x10FFFF]: [#xdc00]"); }
+    @Test public void not_wf_sa_168 () throws Exception { runInvalidSurrogate ("not-wf/sa/168.xml", (char) 0xd800, "Line 1, column 6: Illegal character found in text. Character after first in surrogate pair is not between 0xDC00 and 0xDFFF: 3c"); }
+    @Test public void not_wf_sa_169 () throws Exception { runInvalidSurrogate ("not-wf/sa/169.xml", (char) 0xdc00, "Line 1, column 6: Illegal character found in text. Allowed values are #x09 | #x0a | #x0d | [#x0020-#xD7FF] | [#xE000-#xFFFD] | [#x10000-#x10FFFF]: [#xdc00]"); }
     // Four byte UTF-8 encodings can encode UCS-4 characters which are beyond the range of legal XML characters (and can't be expressed in Unicode surrogate pairs). This document holds such a character.
     // TODO Java probably swallows this :/ @Test public void not_wf_sa_170 () throws Exception { runInvalid ("not-wf/sa/170.xml", ""); }
     @Test public void not_wf_sa_171 () throws Exception { runInvalid ("not-wf/sa/171.xml", "Line 1, column 6: Illegal character found in comment. Allowed values are #x09 | #x0a | #x0d | [#x0020-#xD7FF] | [#xE000-#xFFFD] | [#x10000-#x10FFFF]: [#xffff]"); }
@@ -410,6 +411,29 @@ public class XMLConformanceTest
     // TODO Tests the Entity Declared WFC. Note: a nonvalidating parser is permitted not to report this WFC violation, since it would need to read an external parameter entity to distinguish it from a violation of the Standalone Declaration VC @Test public void not_wf_sa_185 () throws Exception { runInvalid ("not-wf/sa/185.xml", ""); }
     @Test public void not_wf_sa_186 () throws Exception { runInvalid ("not-wf/sa/186.xml", "Line 5, column 9: Expected whitespace between attributes of element a but found Token (ATTRIBUTE, 95:100, \"d=\\\"e\\\"\")"); }
 
+    private void runInvalidSurrogate (String fileName, char surrogate, String message) throws IOException
+    {
+        try
+        {
+            run (new XMLParser (), fileName);
+            fail ("Malformed UTF-8 was accepted: "+fileName);
+        }
+        catch (MalformedInputException expected)
+        {
+            assertTrue (expected.getInputLength () > 0);
+        }
+
+        try
+        {
+            new XMLParser ().parse (new XMLStringSource ("<doc>"+surrogate+"</doc>"));
+            fail ("Unpaired surrogate was accepted");
+        }
+        catch (XMLParseException expected)
+        {
+            assertEquals (message, expected.getMessage ());
+        }
+    }
+
     private void runInvalid (String fileName, String exceptionMessage) throws IOException
     {
         try
