From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Subject: [PATCH] Use a file repository for resolver integration tests

Resolve the newly built harness into each temporary local repository.
Keep the repository session, transfer and logging assertions in both
the ordinary and nested tests.

Upstream: downstream adaptation for offline RPM builds
Reference: https://github.com/apache/maven-plugin-testing/blob/maven-plugin-testing-3.5.1/maven-plugin-testing-harness/src/test/java/org/apache/maven/plugin/testing/SimpleResolveMojoTest.java
Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
diff --git a/maven-plugin-testing-harness/src/test/java/org/apache/maven/plugin/testing/SimpleResolveMojoTest.java b/maven-plugin-testing-harness/src/test/java/org/apache/maven/plugin/testing/SimpleResolveMojoTest.java
--- a/maven-plugin-testing-harness/src/test/java/org/apache/maven/plugin/testing/SimpleResolveMojoTest.java
+++ b/maven-plugin-testing-harness/src/test/java/org/apache/maven/plugin/testing/SimpleResolveMojoTest.java
@@ -22,6 +22,11 @@
 import javax.inject.Inject;
 
 import java.io.File;
+import java.util.Collections;
+
+import org.apache.maven.artifact.repository.ArtifactRepositoryPolicy;
+import org.apache.maven.artifact.repository.MavenArtifactRepository;
+import org.apache.maven.artifact.repository.layout.DefaultRepositoryLayout;
 
 import org.apache.maven.api.plugin.testing.InjectMojo;
 import org.apache.maven.api.plugin.testing.MojoParameter;
@@ -58,15 +63,15 @@
         // default would be basedir/target/local-repo
         session.getRequest().setLocalRepositoryPath(tempDir);
 
-        // other customizations can be done here, if needed
-        // session.getRequest().setRemoteRepositories(customRemoteRepositories());
-        // session.getRequest().setOffline(true);
-        // session.getUserProperties().setProperty("maven.repo.local.tail", "your local repository");
+        String remote = new File(System.getProperty("testRepository")).toURI().toString();
+        ArtifactRepositoryPolicy policy = new ArtifactRepositoryPolicy();
+        session.getRequest().setRemoteRepositories(Collections.singletonList(new MavenArtifactRepository(
+                "central", remote, new DefaultRepositoryLayout(), policy, policy)));
     }
 
     @Test
     @InjectMojo(goal = "simple-resolve")
-    @MojoParameter(name = "artifact", value = "org.apache.commons:commons-lang3:3.20.0")
+    @MojoParameter(name = "artifact", value = "org.apache.maven.plugin-testing:maven-plugin-testing-harness:3.5.1")
     void artifactShouldBeResolved(SimpleResolveMojo mojo) {
         assertDoesNotThrow(mojo::execute);
 
@@ -77,7 +82,7 @@
     class NestedTest {
         @Test
         @InjectMojo(goal = "simple-resolve")
-        @MojoParameter(name = "artifact", value = "org.apache.commons:commons-lang3:3.20.0")
+        @MojoParameter(name = "artifact", value = "org.apache.maven.plugin-testing:maven-plugin-testing-harness:3.5.1")
         void artifactShouldBeResolved(SimpleResolveMojo mojo) {
             assertDoesNotThrow(mojo::execute);
 
