From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Subject: [PATCH] Keep validation tests independent of serializer formatting

Ignore only a redundant declaration of the implicitly bound xml prefix.
Keep all remaining output and error-count assertions. The current sample
has no incorrect relationship type, so explicitly introduce one in the
temporary extracted test package. Retain the expectation of one error.

Signed-off-by: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
---
--- a/src/org/probatron/officeotron/MceXmlFilterTest.java
+++ b/src/org/probatron/officeotron/MceXmlFilterTest.java
@@ -231,7 +231,7 @@
 		
 		String actual = filter( test );
 		
-		assertEquals( expected, actual );
+		assertXmlEquals( expected, actual );
 		assertEquals( "xml:lang and xml:space in <mc:Choice> should be reported", 2, mErrorHandler.getInstanceErrCount() );
 	}
 	
@@ -250,7 +250,7 @@
 		
 		String actual = filter( test );
 		
-		assertEquals( expected, actual );
+		assertXmlEquals( expected, actual );
 		assertEquals( "<mc:Choice> with no <mc:AlternateContent> parent should be reported", 1, mErrorHandler.getInstanceErrCount() );
 	}
 	
@@ -269,7 +269,7 @@
 		
 		String actual = filter( test );
 		
-		assertEquals( expected, actual );
+		assertXmlEquals( expected, actual );
 		assertEquals( "<mc:Fallback> with no <mc:AlternateContent> parent should be reported", 1, mErrorHandler.getInstanceErrCount() );
 	}
 	
@@ -392,4 +392,11 @@
 		
 		return writer.toString();
 	}
+
+    private static void assertXmlEquals(String expected, String actual) {
+        // The xml prefix is implicitly bound. Serializers may omit its redundant
+        // declaration; retain exact comparisons of every other character.
+        String implicit = "xmlns:xml=\"http://www.w3.org/XML/1998/namespace\" ";
+        assertEquals(expected.replace(implicit, ""), actual.replace(implicit, ""));
+    }
 }
--- a/src/org/probatron/officeotron/OOXMLValidationSessionTest.java
+++ b/src/org/probatron/officeotron/OOXMLValidationSessionTest.java
