     }
 
-    private File getDirectorRepositoryZip(ArtifactRepository localMavenRepository) {
-        // this artifact is a dependency of the Mojo, so we expect it in the local Maven repo
+    private File getDirectorRepositoryZip(ArtifactRepository localMavenRepository) throws MojoExecutionException {
         Artifact artifact = repositorySystem.createArtifact("org.eclipse.tycho", "tycho-bundles-external", "2.7.5",
-                "eclipse-repository");
-        return new File(localMavenRepository.getBasedir(), localMavenRepository.pathOf(artifact));
+                "zip");
+        File cached = new File(localMavenRepository.getBasedir(), localMavenRepository.pathOf(artifact));
+        if (cached.isFile()) {
+            return cached;
+        }
+        MavenSession session = context.getSession();
+        if (session == null) {
+            throw new MojoExecutionException("No Maven session for resolving the standalone director repository");
+        }
+        ArtifactResolutionRequest request = new ArtifactResolutionRequest();
+        request.setArtifact(artifact);
+        request.setResolveRoot(true);
+        request.setResolveTransitively(false);
+        request.setOffline(session.isOffline());
+        request.setLocalRepository(localMavenRepository);
+        request.setRemoteRepositories(session.getCurrentProject().getPluginArtifactRepositories());
+        ArtifactResolutionResult result = repositorySystem.resolve(request);
+        if (result.hasExceptions()) {
+            throw new MojoExecutionException("Could not resolve the standalone director repository",
+                    result.getExceptions().get(0));
+        }
+        File resolved = artifact.getFile();
+        if (resolved == null || !resolved.isFile()) {
+            throw new MojoExecutionException("The standalone director repository was not resolved");
+        }
+        return resolved;
     }
 }
