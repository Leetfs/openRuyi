+import org.apache.maven.artifact.handler.DefaultArtifactHandler;
+import org.apache.maven.artifact.repository.ArtifactRepository;
+import org.apache.maven.artifact.resolver.ArtifactResolutionRequest;
+import org.apache.maven.artifact.resolver.ArtifactResolutionResult;
+import org.apache.maven.execution.MavenSession;
+import org.apache.maven.plugin.LegacySupport;
+import org.apache.maven.plugin.MojoExecutionException;
+import org.apache.maven.project.MavenProject;
+import org.apache.maven.repository.RepositorySystem;
+import org.junit.Before;
+import org.junit.Rule;
+import org.junit.Test;
+import org.junit.rules.TemporaryFolder;
+import org.mockito.ArgumentCaptor;
+
+public class StandaloneDirectorRuntimeFactoryTest {
+    @Rule
+    public TemporaryFolder folder = new TemporaryFolder();
+
+    private Path temporary;
+
+    private StandaloneDirectorRuntimeFactory factory;
+    private RepositorySystem repositorySystem;
+    private LegacySupport context;
+    private ArtifactRepository localRepository;
+    private Artifact artifact;
+    private Method resolve;
+
+    @Before
+    public void prepare() throws Exception {
+        temporary = folder.getRoot().toPath();
+        repositorySystem = mock(RepositorySystem.class);
+        context = mock(LegacySupport.class);
+        localRepository = mock(ArtifactRepository.class);
+        artifact = new DefaultArtifact("org.eclipse.tycho", "tycho-bundles-external", "2.7.5", "compile", "zip",
+                null, new DefaultArtifactHandler("zip"));
+        when(repositorySystem.createArtifact("org.eclipse.tycho", "tycho-bundles-external", "2.7.5", "zip"))
+                .thenReturn(artifact);
+        when(localRepository.getBasedir()).thenReturn(temporary.toString());
+        when(localRepository.pathOf(artifact)).thenReturn("repository.zip");
+        factory = new StandaloneDirectorRuntimeFactory();
+        inject("repositorySystem", repositorySystem);
+        inject("context", context);
+        resolve = StandaloneDirectorRuntimeFactory.class.getDeclaredMethod("getDirectorRepositoryZip",
+                ArtifactRepository.class);
+        resolve.setAccessible(true);
+    }
+
+    private void inject(String name, Object value) throws Exception {
+        Field field = StandaloneDirectorRuntimeFactory.class.getDeclaredField(name);
+        field.setAccessible(true);
+        field.set(factory, value);
+    }
+
+    private void offlineSession() {
+        MavenSession session = mock(MavenSession.class);
+        MavenProject project = mock(MavenProject.class);
+        when(context.getSession()).thenReturn(session);
+        when(session.isOffline()).thenReturn(true);
+        when(session.getCurrentProject()).thenReturn(project);
+        when(project.getPluginArtifactRepositories()).thenReturn(List.of());
+    }
+
+    @Test
+    public void usesCachedRepositoryWithoutResolution() throws Exception {
+        Path archive = Files.createFile(temporary.resolve("repository.zip"));
+        assertEquals(archive.toFile(), resolve.invoke(factory, localRepository));
+        verifyNoInteractions(context);
+    }
+
+    @Test
+    public void resolvesOnlyWhenSelectedAndPreservesOfflineMode() throws Exception {
+        offlineSession();
+        Path archive = Files.createFile(temporary.resolve("resolved.zip"));
+        when(repositorySystem.resolve(any(ArtifactResolutionRequest.class))).thenAnswer(invocation -> {
+            artifact.setFile(archive.toFile());
+            return new ArtifactResolutionResult();
+        });
+        assertEquals(archive.toFile(), resolve.invoke(factory, localRepository));
+        ArgumentCaptor<ArtifactResolutionRequest> request = ArgumentCaptor.forClass(ArtifactResolutionRequest.class);
+        verify(repositorySystem).resolve(request.capture());
+        assertTrue(request.getValue().isOffline());
+        assertEquals(localRepository, request.getValue().getLocalRepository());
+    }
+
+    @Test
+    public void rejectsAnUnresolvedRepository() throws Exception {
+        offlineSession();
+        when(repositorySystem.resolve(any(ArtifactResolutionRequest.class)))
+                .thenReturn(new ArtifactResolutionResult());
+        InvocationTargetException exception = assertThrows(InvocationTargetException.class,
+                () -> resolve.invoke(factory, localRepository));
+        assertTrue(exception.getCause() instanceof MojoExecutionException);
+    }
+}
