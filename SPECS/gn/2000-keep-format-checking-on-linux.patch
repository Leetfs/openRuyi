From 304dc224d5ed9b50fa83fdef5027f6dda742ff19 Mon Sep 17 00:00:00 2001
From: Li Guan <guanli.oerv@isrc.iscas.ac.cn>
Date: Wed, 4 Nov 2026 02:33:49 +0800
Subject: [PATCH] Keep format checking enabled on Linux

---
 build/gen.py | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/build/gen.py b/build/gen.py
index e4e377e..90839bd 100644
--- a/build/gen.py
+++ b/build/gen.py
@@ -625,11 +625,13 @@ def WriteGNNinja(path, platform, host, options, args_list):
         '-Wno-implicit-fallthrough',
         '-Wno-redundant-move',
         '-Wno-unused-variable',
-        '-Wno-format',             # Use of %llx, which is supported by _UCRT, false positive
         '-Wno-strict-aliasing',    # Dereferencing punned pointer
         '-Wno-cast-function-type', # Casting FARPROC to RegDeleteKeyExPtr
       ])
 
+      if not platform.is_linux():
+        cflags.append('-Wno-format')  # UCRT accepts %llx.
+
     elif platform.is_darwin():
       # Feel free to bump this value whenever you want, as long as all non-EOL
       # macOS versions are supported.
-- 
2.54.0

