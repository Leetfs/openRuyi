-        String script =
-                "import java.net.URL;\n" +
-                "url = new URL(\"https://github.com/beanshell\");\n" +
-                "urlConnection = url.openConnection();\n" +
-                "stream = urlConnection.getInputStream();\n" +
-                "stream.close();\n";
-        new Interpreter().eval(script);
+    public void do_not_access_non_open_methods() throws Exception {
+        Path fixture = Files.createTempFile("beanshell-module-access", ".jar");
+        try {
+            try (JarOutputStream out = new JarOutputStream(Files.newOutputStream(fixture))) {
+                out.putNextEntry(new JarEntry("input"));
+                out.write(42);
+                out.closeEntry();
+            }
+            Interpreter interpreter = new Interpreter();
+            interpreter.set("url", new URL("jar:" + fixture.toUri().toURL() + "!/input"));
+            assertEquals(42, interpreter.eval(
+                    "connection = url.openConnection(); input = connection.getInputStream();"
+                    + "value = input.read(); input.close(); return value;"));
+        } finally {
+            Files.delete(fixture);
+        }
     }
 
 }
