From b6d764e0984d710e315eac00df6eda6f69bedc5e Mon Sep 17 00:00:00 2001
From: CHEN Xuan <chenxuan@iscas.ac.cn>
Date: Sun, 20 Sep 2026 13:12:02 +0800
Subject: [PATCH] ROCm hipSPARSELt ordering

Find hipSPARSELt before Torch so the roc::hipsparselt target exists when Torch's exported CMake targets reference it.
---
 CMakeLists.txt | 1 +
 1 file changed, 1 insertion(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index bf7a58e..ad9a982 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -109,6 +109,7 @@ endif()
 # so there is no need to do this explicitly with check_language/enable_language,
 # etc.
 #
+find_package(hipsparselt CONFIG REQUIRED)
 find_package(Torch REQUIRED)
 
 # Supported NVIDIA architectures.
-- 
